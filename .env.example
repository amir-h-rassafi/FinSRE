# Copy this file to .env for local development.
# Do not commit .env.

FINSRE_ENVIRONMENT=local

# Optional GCP billing account id, without or with the billingAccounts/ prefix.
FINSRE_GCP_BILLING_ACCOUNT=012345-6789AB-CDEF01
FINSRE_GCP_BILLING_CURRENCY=USD

# Optional LLM settings. Required only for commands that use --approve-llm.
FINSRE_LLM_PROVIDER=openai
FINSRE_LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
